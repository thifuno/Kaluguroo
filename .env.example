# Kaluguroo environment variables
# Copy this file to .env and fill in the values you have.
# Anything prefixed with EXPO_PUBLIC_ is bundled into the app.
# Never put provider API keys or Supabase service-role keys here.

# Supabase project (Phase 2). Leave empty to use local storage only.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Secure backend endpoint that accepts a multipart "image" upload and returns:
# { "name": string, "calories": number, "protein": number, "carbs": number, "fat": number }
# Leave empty to keep AI scanning disabled. The UI will say so explicitly.
EXPO_PUBLIC_AI_API_URL=
