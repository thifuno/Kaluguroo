{
  "expo": {
    "name": "Kaluguroo",
    "slug": "kaluguroo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "kaluguroo",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FAF7F3",
    "ios": {
      "icon": "./assets/expo.icon",
      "supportsTablet": true,
      "bundleIdentifier": "com.kaluguroo.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Kaluguroo uses the camera to photograph meals for AI nutrition estimates.",
        "NSPhotoLibraryUsageDescription": "Kaluguroo lets you choose a meal photo from your library for nutrition estimates."
      }
    },
    "android": {
      "package": "com.kaluguroo.app",
      "adaptiveIcon": {
        "backgroundColor": "#FFEDE5",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAF7F3",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Kaluguroo uses the camera to photograph meals for AI nutrition estimates.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Kaluguroo lets you choose a meal photo from your library for nutrition estimates."
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
